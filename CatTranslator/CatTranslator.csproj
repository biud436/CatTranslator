<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>CatTranslator</RootNamespace>
    <AssemblyName>CatTranslator</AssemblyName>
    <Product>Cat Translator</Product>
    <SatelliteResourceLanguages>en;ko</SatelliteResourceLanguages>
    <!-- Generated from the cat drawing in CatWindow.xaml; used for the exe, shortcuts and window title bars. -->
    <ApplicationIcon>Assets\cat.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Anthropic" Version="13.8.0" />
  </ItemGroup>

</Project>
