<Window x:Class="CatTranslator.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="설정 - 고양이 번역기"
        Width="500" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
    <StackPanel Margin="16">
        <TextBlock Text="Claude API 키" FontWeight="Bold" />
        <DockPanel Margin="0,4,0,0">
            <Button DockPanel.Dock="Right" x:Name="DeleteKeyButton" Content="저장된 키 삭제"
                    Click="OnDeleteKey" Style="{StaticResource DialogButton}" />
            <PasswordBox x:Name="ApiKeyBox" Padding="4,3" />
        </DockPanel>
        <TextBlock x:Name="KeyStatusText" Margin="0,4,0,0" TextWrapping="Wrap" />
        <TextBlock Margin="0,2,0,0" TextWrapping="Wrap" Foreground="Gray" FontSize="11"
                   Text="키는 현재 Windows 사용자 계정으로만 복호화할 수 있도록 DPAPI로 암호화해서 저장합니다. 입력란을 비워 두고 저장하면 기존 키를 그대로 유지합니다." />

        <TextBlock Text="모델" FontWeight="Bold" Margin="0,14,0,0" />
        <TextBox x:Name="ModelBox" Margin="0,4,0,0" Padding="4,3" />

        <TextBlock Text="번역 단축키" FontWeight="Bold" Margin="0,14,0,0" />
        <TextBox x:Name="HotkeyBox" Margin="0,4,0,0" Padding="4,3" IsReadOnly="True" IsReadOnlyCaretVisible="True"
                 PreviewKeyDown="OnHotkeyKeyDown" />
        <TextBlock x:Name="HotkeyHint" Margin="0,4,0,0" Foreground="Gray" FontSize="11" TextWrapping="Wrap"
                   Text="입력란을 클릭한 뒤 원하는 조합(예: Ctrl+Alt+T)을 누르세요." />

        <CheckBox x:Name="DoubleCopyBox" Margin="0,14,0,0"
                  Content="Ctrl+C를 빠르게 두 번 누르면 바로 번역 (비밀번호 관리자에서 복사한 내용은 제외)" />

        <CheckBox x:Name="SaveHistoryBox" Margin="0,8,0,0"
                  Content="번역 기록(최근 20건)을 디스크에 저장해서 다음 실행 때도 유지" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="저장" IsDefault="True" Click="OnSave" Style="{StaticResource DialogButton}" />
            <Button Content="취소" IsCancel="True" Style="{StaticResource DialogButton}" />
        </StackPanel>
    </StackPanel>
</Window>
